import { AboutSlint, LineEdit, ListView, Palette, Slider } from "std-widgets.slint";
import "../assets/fonts/SourceHanSansCN-Regular.otf";

export struct ProjectItem {
    id: string,
    title: string,
    path: string,
    status: string,
    selected: bool,
}

export struct LyricItem {
    text: string,
    at-seconds: float,
}

global Tokens {
    // A rehearsal room, not a generic media player: indigo walls, paper lyrics,
    // and one coral cue mark where the singer should enter.
    out property <color> ink: #f4efe6;
    out property <color> muted: #9f9caf;
    out property <color> faint: #66657a;
    out property <color> canvas: #15162b;
    out property <color> stage: #0b0c14;
    out property <color> panel: #1f2139;
    out property <color> raised: #292b47;
    out property <color> line: #393b58;
    out property <color> cue: #ff776d;
    out property <color> lyric-current: #ffd66b;
    out property <color> lyric-upcoming: #a9a7b5;
    out property <color> lyric-played: #414255;
    out property <color> paper: #f4efe6;
    out property <color> paper-ink: #242337;
    out property <color> danger: #ff8c85;
}

component SectionLabel inherits Text {
    color: Tokens.muted;
    font-family: "monospace";
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.3px;
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <string> accessible-name: label;
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    callback clicked;

    height: 36px;
    min-width: 36px;
    border-radius: root.primary ? 18px : 5px;
    background: !root.enabled ? (root.primary ? Tokens.raised : transparent) : root.primary ? Tokens.cue : action-touch.has-hover || action-focus.has-focus ? Tokens.raised : transparent;
    border-width: 0px;
    opacity: root.enabled ? 1 : 0.35;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;

    if root.icon.width > 0 && root.icon.height > 0: Image {
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        image-fit: contain;
        colorize: !root.enabled ? Tokens.muted : root.primary ? Tokens.paper-ink : Tokens.ink;
    }
    if root.icon.width == 0 || root.icon.height == 0: Text {
        text: root.label;
        color: !root.enabled ? Tokens.muted : root.primary ? Tokens.paper-ink : Tokens.ink;
        font-size: 12px;
        font-weight: root.primary ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    action-touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    action-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

component PlayButton inherits Rectangle {
    in property <bool> playing;
    in property <bool> enabled: true;
    callback clicked;

    width: 54px;
    height: 54px;
    border-radius: 27px;
    background: !root.enabled ? Tokens.raised : play-focus.has-focus ? Tokens.lyric-current : Tokens.paper;
    border-width: 0px;
    opacity: root.enabled ? 1 : 0.35;
    accessible-role: button;
    accessible-label: root.playing ? "Pause" : "Play";
    accessible-enabled: root.enabled;

    Image {
        width: 20px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.playing ? @image-url("../assets/pause.svg") : @image-url("../assets/play.svg");
        image-fit: contain;
        colorize: Tokens.paper-ink;
    }

    play-touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    play-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

component TrackPill inherits Rectangle {
    in property <string> label;
    in property <string> unavailable-reason;
    in property <bool> active;
    in property <bool> enabled: true;
    callback selected;

    height: 34px;
    border-radius: 5px;
    background: active ? Tokens.paper : track-touch.has-hover || track-focus.has-focus ? Tokens.raised : transparent;
    border-width: 0px;
    opacity: enabled ? 1 : 0.35;
    accessible-role: button;
    accessible-label: label;
    accessible-description: enabled ? label : unavailable-reason;
    accessible-enabled: enabled;

    Text {
        text: root.label;
        color: root.active ? Tokens.paper-ink : Tokens.muted;
        font-size: 12px;
        font-weight: root.active ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    track-touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.selected(); }
    }

    track-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.selected();
                return accept;
            }
            return reject;
        }
    }
}

export component K3Window inherits Window {
    init => { Palette.color-scheme = ColorScheme.dark; }
    title: "K3 — Karaoke stage";
    background: Tokens.canvas;
    default-font-family: "Source Han Sans CN";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 640px;

    in property <[ProjectItem]> projects;
    in property <[LyricItem]> lyrics;
    in-out property <string> projects-root;
    in-out property <string> search-query;
    in-out property <bool> setup-mode: true;
    in-out property <bool> loading: false;
    in-out property <bool> show-about: false;
    in-out property <bool> confirm-root-change: false;
    in-out property <bool> follow-lyrics: true;
    in-out property <length> lyric-scroll-y: 0px;
    in-out property <int> focus-search-serial: 0;

    in property <string> song-title: "Choose a project";
    in property <string> project-state: "Library ready";
    in property <string> error-message;
    in property <string> log-path;
    in property <bool> has-error: false;
    in-out property <bool> playback-error-visible: false;
    in-out property <bool> switching-track: false;
    in-out property <bool> project-changed: false;
    in-out property <string> current-project-id;
    in property <bool> playback-ready: false;
    in property <bool> playing: false;
    in property <float> position-seconds: 0;
    in property <float> duration-seconds: 0;
    in-out property <float> volume: 1;
    in property <int> key-shift: 0;
    in property <int> active-track: 0;
    in property <bool> original-available: false;
    in property <bool> accompaniment-available: false;
    in property <bool> vocals-available: false;
    in property <int> active-lyric: -1;
    in property <int> lyric-countdown-index: -1;
    in property <int> lyric-countdown-dots: 0;

    callback choose-projects-root;
    callback save-projects-root(string);
    callback search(string);
    callback refresh-library;
    callback open-project(string);
    callback playback-command(string);
    callback seek-to(float);
    callback set-volume(float);
    callback save-volume(float);
    callback set-key(int);
    callback switch-track(int);
    callback seek-lyric(float);

    function format-time(seconds: float) -> string {
        if (seconds <= 0) { return "0:00"; }
        let total = round(seconds);
        let minutes = floor(total / 60);
        let remainder = total - minutes * 60;
        return minutes + (remainder < 10 ? ":0" : ":") + remainder;
    }

    forward-focus: shortcuts;
    shortcuts := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (root.show-about) {
                    root.show-about = false; return accept;
                }
                if (root.confirm-root-change) {
                    root.confirm-root-change = false; return accept;
                }
                if (root.setup-mode && root.projects-root != "") {
                    root.setup-mode = false; return accept;
                }
                return reject;
            }
            if (event.text == " " && root.playback-ready) {
                root.playback-command("toggle"); return accept;
            }
            if (event.text == Key.LeftArrow && root.playback-ready) {
                root.playback-command("back"); return accept;
            }
            if (event.text == Key.RightArrow && root.playback-ready) {
                root.playback-command("forward"); return accept;
            }
            if (event.text == Key.UpArrow) {
                root.set-volume(min(1, root.volume + 0.05)); return accept;
            }
            if (event.text == Key.DownArrow) {
                root.set-volume(max(0, root.volume - 0.05)); return accept;
            }
            if (event.text == "1" && root.original-available) { root.switch-track(0); return accept; }
            if (event.text == "2" && root.accompaniment-available) { root.switch-track(1); return accept; }
            if (event.text == "3" && root.vocals-available) { root.switch-track(2); return accept; }
            return reject;
        }

        KeyBinding {
            keys: @keys(Control + R);
            activated => { root.refresh-library(); }
        }
        KeyBinding {
            keys: @keys(Control + F);
            activated => { root.focus-search-serial += 1; }
        }

    if root.setup-mode: Rectangle {
        background: Tokens.canvas;

        Rectangle {
            width: 640px;
            height: 430px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            background: Tokens.panel;
            border-width: 1px;
            border-color: Tokens.line;

            Rectangle {
                width: 6px;
                x: 0px;
                y: 48px;
                height: parent.height - 96px;
                background: Tokens.cue;
            }

            VerticalLayout {
                padding-left: 58px;
                padding-right: 52px;
                padding-top: 42px;
                padding-bottom: 38px;
                spacing: 20px;

                HorizontalLayout {
                    height: 30px;
                    Text {
                        text: "K3";
                        color: Tokens.cue;
                        font-size: 18px;
                        font-weight: 800;
                        letter-spacing: 4px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    SectionLabel {
                        text: "REHEARSAL ROOM";
                        vertical-alignment: center;
                    }
                    if root.projects-root != "": ActionButton {
                        width: 30px;
                        height: 30px;
                        accessible-name: "Cancel folder selection";
                        icon: @image-url("../assets/close.svg");
                        clicked => { root.setup-mode = false; }
                    }
                }
                Text {
                    text: "Find your songbook";
                    color: Tokens.ink;
                    font-size: 34px;
                    font-weight: 650;
                }
                Text {
                    text: "Choose the folder that contains your K3 projects.\nGUI preferences stay separate from the terminal interface.";
                    color: Tokens.muted;
                    font-size: 14px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 10px;
                    LineEdit {
                        text <=> root.projects-root;
                        placeholder-text: "/path/to/k3-projects";
                        height: 42px;
                    }
                    ActionButton {
                        width: 42px;
                        height: 42px;
                        accessible-name: "Browse for projects folder";
                        icon: @image-url("../assets/folder.svg");
                        clicked => { root.choose-projects-root(); }
                    }
                }
                if root.has-error: Text {
                    text: root.error-message;
                    color: Tokens.danger;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    height: 42px;
                    ActionButton {
                        width: 42px;
                        accessible-name: "About K3";
                        icon: @image-url("../assets/info.svg");
                        clicked => { root.show-about = true; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    ActionButton {
                        width: 142px;
                        height: 42px;
                        label: root.loading ? "Checking…" : "Open songbook";
                        primary: true;
                        enabled: !root.loading && root.projects-root != "";
                        clicked => { root.save-projects-root(root.projects-root); }
                    }
                }
            }
        }
    }

    if !root.setup-mode: VerticalLayout {
        spacing: 0px;

        HorizontalLayout {
            spacing: 0px;

            Rectangle {
                width: 304px;
                background: Tokens.panel;
                border-width: 0px;

                VerticalLayout {
                    padding: 22px;
                    spacing: 16px;

                    HorizontalLayout {
                        height: 42px;
                        VerticalLayout {
                            spacing: 1px;
                            Text {
                                text: "K3";
                                color: Tokens.cue;
                                font-size: 17px;
                                font-weight: 800;
                                letter-spacing: 3px;
                            }
                            Text {
                                text: "KARAOKE REHEARSAL";
                                color: Tokens.faint;
                                font-family: "monospace";
                                font-size: 8px;
                                letter-spacing: 1.2px;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        ActionButton {
                            width: 36px;
                            accessible-name: "About K3";
                            icon: @image-url("../assets/info.svg");
                            clicked => { root.show-about = true; }
                        }
                    }

                    search-input := LineEdit {
                        property <int> focus-trigger: root.focus-search-serial;
                        text <=> root.search-query;
                        placeholder-text: "Search projects";
                        edited => { root.search(self.text); }
                        changed focus-trigger => { self.focus(); }
                    }

                    HorizontalLayout {
                        height: 24px;
                        SectionLabel { text: "PROJECTS"; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        ActionButton {
                            width: 28px;
                            height: 28px;
                            accessible-name: "Refresh projects";
                            icon: @image-url("../assets/refresh.svg");
                            clicked => { root.refresh-library(); }
                        }
                    }

                    ListView {
                        vertical-stretch: 1;
                        for project[index] in root.projects: project-row := Rectangle {
                            height: 68px;
                            border-radius: 5px;
                            background: project.selected ? Tokens.raised : project-touch.has-hover ? #252742 : transparent;
                            border-width: project.selected || project-focus.has-focus ? 1px : 0px;
                            border-color: project-focus.has-focus ? Tokens.cue : Tokens.line;
                            accessible-role: list-item;
                            accessible-label: project.title;

                            VerticalLayout {
                                padding-left: 14px;
                                padding-right: 12px;
                                padding-top: 9px;
                                padding-bottom: 9px;
                                spacing: 3px;
                                Text {
                                    text: project.title;
                                    color: project.selected ? Tokens.ink : #cbc7d2;
                                    font-size: 14px;
                                    font-weight: project.selected ? 600 : 400;
                                    overflow: elide;
                                }
                                Text {
                                    text: project.status;
                                    color: project.status == "Repair needed" ? Tokens.danger : Tokens.faint;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }
                            project-touch := TouchArea {
                                clicked => { root.open-project(project.id); }
                            }
                            project-focus := FocusScope {
                                key-pressed(event) => {
                                    if (event.text == Key.Return || event.text == " ") {
                                        root.open-project(project.id);
                                        return accept;
                                    }
                                    return reject;
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Tokens.line;
                    }
                    HorizontalLayout {
                        height: 36px;
                        horizontal-stretch: 1;
                        spacing: 8px;
                        Text {
                            text: root.projects-root;
                            color: Tokens.faint;
                            font-size: 10px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        ActionButton {
                            width: 36px;
                            accessible-name: "Change projects folder";
                            icon: @image-url("../assets/folder.svg");
                            clicked => {
                                if (root.playing) { root.confirm-root-change = true; }
                                else { root.setup-mode = true; }
                            }
                        }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: Tokens.stage;

                VerticalLayout {
                    padding-left: 44px;
                    padding-right: 44px;
                    padding-top: 24px;
                    padding-bottom: 16px;
                    spacing: 14px;

                    HorizontalLayout {
                        height: 62px;
                        VerticalLayout {
                            spacing: 5px;
                            SectionLabel {
                                text: root.playback-ready ? "NOW REHEARSING" : "READY ROOM";
                                color: root.playback-ready ? Tokens.cue : Tokens.faint;
                            }
                            Text {
                                text: root.song-title;
                                color: Tokens.ink;
                                font-size: 24px;
                                font-weight: 650;
                                overflow: elide;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            width: 220px;
                            spacing: 4px;
                            alignment: center;
                            Text {
                                text: root.project-state;
                                color: root.has-error ? Tokens.danger : Tokens.muted;
                                font-size: 11px;
                                horizontal-alignment: right;
                                overflow: elide;
                            }
                            Text {
                                text: root.playback-ready ? root.format-time(root.position-seconds) + " / " + root.format-time(root.duration-seconds) : "WAITING FOR A SONG";
                                color: root.playback-ready ? Tokens.ink : Tokens.faint;
                                font-family: "monospace";
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: right;
                            }
                        }
                    }

                    if root.has-error: Rectangle {
                        height: 44px;
                        border-radius: 5px;
                        background: #3d2534;
                        border-width: 1px;
                        border-color: #5a2d31;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 8px;
                            spacing: 10px;
                            Text {
                                text: root.error-message;
                                color: Tokens.danger;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            if root.playback-error-visible: ActionButton {
                                width: 32px;
                                height: 32px;
                                accessible-name: "Retry playback";
                                icon: @image-url("../assets/refresh.svg");
                                clicked => { root.playback-command("retry"); }
                            }
                        }
                    }

                    if root.project-changed: Rectangle {
                        height: 44px;
                        border-radius: 5px;
                        background: #343044;
                        border-width: 1px;
                        border-color: #6c6370;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 8px;
                            spacing: 10px;
                            Text {
                                text: "This project changed on disk. Reload to use the latest version.";
                                color: Tokens.ink;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            ActionButton {
                                width: 32px;
                                height: 32px;
                                accessible-name: "Reload project";
                                icon: @image-url("../assets/refresh.svg");
                                clicked => { root.open-project(root.current-project-id); }
                            }
                        }
                    }

                    HorizontalLayout {
                        height: 22px;
                        SectionLabel {
                            text: "LYRIC CUE";
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if !root.follow-lyrics && root.lyrics.length > 0: ActionButton {
                            width: 142px;
                            height: 28px;
                            label: "Follow current line";
                            clicked => { root.follow-lyrics = true; }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        background: transparent;

                        if root.lyrics.length == 0: VerticalLayout {
                            alignment: center;
                            spacing: 8px;
                            Text {
                                text: root.playback-ready ? "Instrumental rehearsal" : "Choose a song from the left";
                                color: Tokens.muted;
                                font-size: 22px;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: root.playback-ready ? "This project has no synced lyrics." : "Its lyrics and playback controls will appear here.";
                                color: Tokens.faint;
                                font-size: 12px;
                                horizontal-alignment: center;
                            }
                        }

                        if root.lyrics.length > 0: lyrics-list := ListView {
                            viewport-y <=> root.lyric-scroll-y;
                            scrolled => { root.follow-lyrics = false; }
                            for lyric[index] in root.lyrics: lyric-row := Rectangle {
                                property <int> cue-index: max(0, root.active-lyric);
                                property <bool> current: index == self.cue-index;
                                property <bool> played: index < self.cue-index;
                                property <bool> countdown: index == root.lyric-countdown-index && root.lyric-countdown-dots > 0;

                                height: 64px;
                                background: transparent;

                                if lyric-row.current: Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    y: parent.height - 5px;
                                    width: 42px;
                                    height: 3px;
                                    border-radius: 2px;
                                    background: Tokens.lyric-current;
                                }
                                if lyric-row.countdown: Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    y: 3px;
                                    width: 36px;
                                    height: 6px;
                                    background: transparent;

                                    Rectangle {
                                        x: 0px;
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: Tokens.lyric-current;
                                    }
                                    Rectangle {
                                        x: 15px;
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: Tokens.lyric-current;
                                        opacity: root.lyric-countdown-dots >= 2 ? 1 : 0.16;
                                    }
                                    Rectangle {
                                        x: 30px;
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: Tokens.lyric-current;
                                        opacity: root.lyric-countdown-dots >= 3 ? 1 : 0.16;
                                    }
                                }
                                Text {
                                    x: 18px;
                                    y: lyric-row.countdown ? 8px : 0px;
                                    width: parent.width - 36px;
                                    height: parent.height - (lyric-row.countdown ? 8px : 0px);
                                    text: lyric.text;
                                    color: lyric-row.current ? Tokens.lyric-current : lyric-row.played ? Tokens.lyric-played : Tokens.lyric-upcoming;
                                    font-size: lyric-row.current ? 28px : 16px;
                                    font-weight: lyric-row.current ? 700 : 400;
                                    letter-spacing: lyric-row.current ? 0.4px : 0px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                TouchArea {
                                    clicked => {
                                        root.follow-lyrics = true;
                                        root.seek-lyric(lyric.at-seconds);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 168px;
            background: Tokens.panel;
            border-width: 1px;
            border-color: Tokens.line;

            VerticalLayout {
                padding-left: 24px;
                padding-right: 24px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 10px;

                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        width: 46px;
                        text: root.format-time(root.position-seconds);
                        color: Tokens.muted;
                        font-family: "monospace";
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    timeline := Slider {
                        enabled: root.playback-ready;
                        minimum: 0;
                        maximum: max(1, root.duration-seconds);
                        value: root.position-seconds;
                        released(value) => { root.seek-to(value); }
                    }
                    Text {
                        width: 46px;
                        text: root.format-time(root.duration-seconds);
                        color: Tokens.muted;
                        font-family: "monospace";
                        font-size: 11px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 18px;

                    VerticalLayout {
                        width: 284px;
                        spacing: 7px;
                        SectionLabel { text: root.switching-track ? "STEM · SWITCHING" : "STEM"; }
                        HorizontalLayout {
                            spacing: 6px;
                            TrackPill {
                                width: 82px;
                                label: "Original";
                                unavailable-reason: "Original audio is unavailable";
                                active: root.active-track == 0;
                                enabled: root.original-available && !root.switching-track;
                                selected => { root.switch-track(0); }
                            }
                            TrackPill {
                                width: 102px;
                                label: "Backing";
                                unavailable-reason: "Backing track is unavailable";
                                active: root.active-track == 1;
                                enabled: root.accompaniment-available && !root.switching-track;
                                selected => { root.switch-track(1); }
                            }
                            TrackPill {
                                width: 82px;
                                label: "Vocals";
                                unavailable-reason: "Vocal track is unavailable";
                                active: root.active-track == 2;
                                enabled: root.vocals-available && !root.switching-track;
                                selected => { root.switch-track(2); }
                            }
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    VerticalLayout {
                        width: 280px;
                        spacing: 3px;
                        SectionLabel {
                            text: root.playing ? "PLAYING" : "TRANSPORT";
                            color: root.playing ? Tokens.cue : Tokens.muted;
                            horizontal-alignment: center;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: center;
                            ActionButton {
                                width: 52px;
                                label: "−5s";
                                enabled: root.playback-ready;
                                clicked => { root.playback-command("back"); }
                            }
                            PlayButton {
                                playing: root.playing;
                                enabled: root.playback-ready;
                                clicked => { root.playback-command("toggle"); }
                            }
                            ActionButton {
                                width: 52px;
                                label: "+5s";
                                enabled: root.playback-ready;
                                clicked => { root.playback-command("forward"); }
                            }
                            ActionButton {
                                width: 42px;
                                accessible-name: "Restart playback";
                                icon: @image-url("../assets/restart.svg");
                                enabled: root.playback-ready;
                                clicked => { root.playback-command("restart"); }
                            }
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    VerticalLayout {
                        width: 298px;
                        spacing: 7px;
                        SectionLabel { text: "KEY"; }
                        HorizontalLayout {
                            spacing: 6px;
                            ActionButton {
                                width: 36px;
                                label: "−";
                                enabled: root.playback-ready && root.key-shift > -6;
                                clicked => { root.set-key(root.key-shift - 1); }
                            }
                            Rectangle {
                                width: 40px;
                                height: 36px;
                                border-radius: 5px;
                                background: Tokens.canvas;
                                Text {
                                    text: root.key-shift > 0 ? "+" + root.key-shift : root.key-shift;
                                    color: Tokens.ink;
                                    font-family: "monospace";
                                    font-size: 13px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            ActionButton {
                                width: 36px;
                                label: "+";
                                enabled: root.playback-ready && root.key-shift < 6;
                                clicked => { root.set-key(root.key-shift + 1); }
                            }
                            ActionButton {
                                width: 50px;
                                label: "Reset";
                                enabled: root.playback-ready && root.key-shift != 0;
                                clicked => { root.set-key(0); }
                            }
                            Image {
                                width: 16px;
                                height: 16px;
                                source: @image-url("../assets/volume.svg");
                                image-fit: contain;
                                colorize: Tokens.muted;
                                vertical-alignment: center;
                            }
                            Slider {
                                width: 90px;
                                minimum: 0;
                                maximum: 1;
                                step: 0.01;
                                value: root.volume;
                                accessible-label: "Volume";
                                changed(value) => { root.set-volume(value); }
                                released(value) => { root.save-volume(value); }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.show-about: Rectangle {
        background: #15162bee;
        TouchArea { clicked => { root.show-about = false; } }
        Rectangle {
            width: 430px;
            height: 310px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            background: Tokens.raised;
            border-width: 1px;
            border-color: Tokens.line;

            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text {
                    text: "K3 · Rehearsal room";
                    color: Tokens.ink;
                    font-size: 22px;
                    font-weight: 650;
                    horizontal-alignment: center;
                }
                AboutSlint { vertical-stretch: 1; }
                Text {
                    text: "Diagnostics: " + root.log-path;
                    color: Tokens.muted;
                    font-size: 10px;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                ActionButton {
                    label: "Close";
                    clicked => { root.show-about = false; }
                }
            }
        }
    }

    if root.confirm-root-change: Rectangle {
        background: #15162bee;
        Rectangle {
            width: 440px;
            height: 210px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            background: Tokens.raised;
            border-width: 1px;
            border-color: Tokens.line;
            VerticalLayout {
                padding: 24px;
                spacing: 16px;
                Text {
                    text: "Change projects folder?";
                    color: Tokens.ink;
                    font-size: 20px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Playback will remain on the current project until you open another one.";
                    color: Tokens.muted;
                    font-size: 12px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 12px;
                    ActionButton {
                        label: "Cancel";
                        clicked => { root.confirm-root-change = false; }
                    }
                    ActionButton {
                        label: "Change folder";
                        primary: true;
                        clicked => {
                            root.confirm-root-change = false;
                            root.setup-mode = true;
                        }
                    }
                }
            }
        }
    }
    }
}
