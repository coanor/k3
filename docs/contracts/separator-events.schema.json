{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://k3.local/contracts/separator-events.schema.json",
  "title": "K3 Separator WebSocket message",
  "oneOf": [
    {
      "type": "object",
      "required": ["action", "job_ids"],
      "properties": {
        "action": {"enum": ["subscribe", "unsubscribe"]},
        "job_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^job_[0-9a-f]+$"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["job_id", "sequence", "status", "stage", "message"],
      "properties": {
        "job_id": {"type": "string", "pattern": "^job_[0-9a-f]+$"},
        "sequence": {"type": "integer", "minimum": 1},
        "status": {
          "enum": ["queued", "running", "cancelling", "cancelled", "completed", "failed"]
        },
        "stage": {"type": "string"},
        "message": {"type": "string"},
        "completed": {"type": "number", "minimum": 0},
        "total": {"type": "number", "exclusiveMinimum": 0},
        "fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "eta_seconds": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": {"type": "string"},
            "message": {"type": "string"},
            "retryable": {"type": "boolean"}
          }
        }
      }
    }
  ]
}
