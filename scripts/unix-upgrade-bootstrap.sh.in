#!/usr/bin/env bash
# Keep the entire bootstrap in one block so a truncated pipe cannot start an update.
{
set -euo pipefail
version='v@K3_VERSION@'
base="https://github.com/coanor/k3/releases/download/$version"
command -v curl >/dev/null || { echo 'Please install curl first' >&2; exit 1; }
if command -v sha256sum >/dev/null; then
    checksum_tool=sha256sum
elif command -v shasum >/dev/null; then
    checksum_tool=shasum
else
    echo 'Please install sha256sum or shasum first' >&2; exit 1
fi
work=$(mktemp -d "${TMPDIR:-/tmp}/k3-upgrade.XXXXXXXX")
trap 'rm -rf -- "$work"' EXIT
curl --proto '=https' --proto-redir '=https' -fsSL --connect-timeout 20 --max-time 60 "$base/install.sh" -o "$work/install.sh"
curl --proto '=https' --proto-redir '=https' -fsSL --connect-timeout 20 --max-time 60 "$base/install.sh.sha256" -o "$work/install.sh.sha256"
checksum=$(cat "$work/install.sh.sha256")
if [[ ! "$checksum" =~ ^([0-9a-f]{64})[[:blank:]]+install\.sh$ ]]; then
    echo 'Installer entry checksum verification failed' >&2; exit 1
fi
expected=${BASH_REMATCH[1]}
if [[ "$checksum_tool" == sha256sum ]]; then
    actual=$(sha256sum "$work/install.sh")
else
    actual=$(shasum -a 256 "$work/install.sh")
fi
if [[ ${actual%% *} != "$expected" || $(wc -c < "$work/install.sh") -gt 262144 ]]; then
    echo 'Installer entry checksum verification failed' >&2; exit 1
fi
bash "$work/install.sh" --update --version "$version" "$@"
}
