& {
    $ErrorActionPreference = 'Stop'
    $version = 'v@K3_VERSION@'
    $base = "https://github.com/coanor/k3/releases/download/$version"
    $response = Invoke-WebRequest -UseBasicParsing -ErrorAction Stop "$base/install.ps1"
    $bytes = $response.RawContentStream.ToArray()
    $fields = (Invoke-RestMethod -ErrorAction Stop "$base/install.ps1.sha256").Trim() -split '\s+'
    $sha = [Security.Cryptography.SHA256]::Create()
    try {
        $actual = ([BitConverter]::ToString($sha.ComputeHash($bytes))).Replace('-', '').ToLowerInvariant()
    } finally {
        $sha.Dispose()
    }
    if ($bytes.Length -gt 262144 -or $fields.Count -ne 2 -or $fields[1] -cne 'install.ps1' -or
        $fields[0] -cnotmatch '^[0-9a-f]{64}$' -or $actual -cne $fields[0]) {
        throw 'Installer entry checksum verification failed'
    }
    $reader = [IO.StreamReader]::new([IO.MemoryStream]::new($bytes), [Text.Encoding]::UTF8)
    try {
        $installer = [scriptblock]::Create($reader.ReadToEnd())
    } finally {
        $reader.Dispose()
    }
    & $installer @K3_INSTALL_ARGUMENTS@
}
